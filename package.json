{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay is an async AI task agent platform that decouples HTTP intake, background workflows, and result delivery for observable long-running LLM jobs.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx workflows/dev-worker.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "ioredis": "5.11.1",
    "lucide-react": "0.468.0",
    "nanoid": "5.1.16",
    "next": "16.3.3",
    "pg": "8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "postcss": "8.5.28",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
